{
  "name": "solana-launch-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "candles:revert": "tsx scripts/candle-policy.ts legacy",
    "candles:prioritise": "tsx scripts/candle-policy.ts priority",
    "candles:discovery": "tsx scripts/candle-policy.ts discovery",
    "candles:balance": "tsx scripts/candle-policy.ts balanced"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@solana/addresses": "^6.10.0",
    "lightweight-charts": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
