# No keys or paid services are required for the initial public-feed pilot.
PORT=4310
DATA_DIR=./data
# Set to 0 to pause network collection. Previously collected real data stays available.
LIVE_SCAN=1
# Optional read-only Solana RPC for LaunchLab migration-wallet reconciliation.
# Public RPC is rate limited; the UI reports failures. No wallet key is needed.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional additional verified migration signers, comma separated.
RAYDIUM_MIGRATION_SIGNERS=RAYpQbFNq9i3mu6cKpTKKRwwHFDeK5AuZz8xvxUrCgw
# Optional Jupiter API key for higher quote rate limits. Quote-only requests currently
# work without a key; failures stay pending. Never put a wallet key here.
# JUPITER_API_KEY=
